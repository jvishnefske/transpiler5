+    def spike_enum_t(self, rs):
+        if not ENUM_SPIKE:
+            return None
+        c = (rs or "").replace("enum ", "").strip()
+        if c.startswith("const "):
+            c = c[6:]
+        if c in self.enum_names or c.split("::")[-1] in self.enum_short:
+            return K.I32
+        return None
+
+    def spike_enums(self, nodes, path):
+        for x in nodes:
+            if not isinstance(x, dict):
+                continue
+            k = x.get("kind")
+            nm = x.get("name") or ""
+            if k == "EnumDecl":
+                if nm:
+                    self.enum_names.add("::".join(path + (nm,)))
+                    self.enum_short.add(nm)
+                v = -1
+                for c in x.get("inner", []):
+                    if c.get("kind") == "EnumConstantDecl":
+                        ex = [y for y in c.get("inner", []) if isinstance(y, dict)]
+                        val = None
+                        while ex and "value" not in ex[0] and ex[0].get("inner"):
+                            ex = [z for z in ex[0]["inner"] if isinstance(z, dict)]
+                        for y in ex[:1]:
+                            if "value" in y:
+                                try:
+                                    val = int(y["value"])
+                                except (TypeError, ValueError):
+                                    pass
+                        v = val if val is not None else v + 1
+                        self.enum_vals[c["id"]] = v
+                continue
+            if k in ("TypedefDecl", "TypeAliasDecl") and "enum " in json.dumps(x.get("type", {})) + json.dumps(x.get("inner", [])[:1]):
+                if nm:
+                    self.enum_names.add("::".join(path + (nm,)))
+                    self.enum_short.add(nm)
+            if k in ("NamespaceDecl", "CXXRecordDecl", "LinkageSpecDecl", "ClassTemplateDecl"):
+                self.spike_enums(x.get("inner", []), path + ((nm,) if nm and k != "LinkageSpecDecl" else ()))
