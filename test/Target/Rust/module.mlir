// FR-8: Module-level emission: use declarations and verbatim text, emitted in order.
// RUN: emitrust-translate --mlir-to-rust %s | FileCheck %s

// CHECK:      use std::vec::Vec;
// CHECK-NEXT: use std::collections::HashMap;
// CHECK-NEXT: // generated by emitrust
emitrust.use "std::vec::Vec"
emitrust.use "std::collections::HashMap"
emitrust.verbatim "// generated by emitrust"

// CHECK:      fn entry() {
// CHECK-NEXT: }
emitrust.func @entry() {
  emitrust.return
}

// CHECK: // trailing text
emitrust.verbatim "// trailing text"
