//===- UBToEmitRust.pdll - Declarative UB patterns --------------*- pdll -*-===//
//
// This file is part of the EmitRust project.
//
//===----------------------------------------------------------------------===//
//
// PDLL implementation of the UB-to-EmitRust pattern: `ub.poison` collapses
// to an `emitrust.constant` holding the deterministic zero/default value of
// its result type (0, 0.0, false). This duplicates the C++ pattern in
// UBToEmitRust.cpp and is only compiled and registered when the top-level
// EMITRUST_ENABLE_PDLL CMake option is ON; the C++ pattern remains the
// shipping baseline.
//
// The pattern carries benefit(2) so that, in the opt-in build, the
// conversion driver prefers it over its benefit-1 C++ duplicate: the
// regular conversion tests then genuinely exercise the declarative
// rewrite, and any divergence from the C++ output fails the suite.
//
// The EmitRust type converter is a strict identity on every type with a
// scalar default, so binding the matched result type directly is exactly
// equivalent to the C++ pattern's convertType call.
//
//===----------------------------------------------------------------------===//

// Note: UBOps.td is not included because it pulls UBOpsInterfaces.td via an
// include relative to its own directory, which mlir-pdll does not resolve.
// `ub.poison` is matched opaquely instead; PDLL only uses ODS includes for
// additional static checking.
#include "EmitRust/EmitRustOps.td"

//===----------------------------------------------------------------------===//
// Native helpers
//===----------------------------------------------------------------------===//

// Succeeds when `type` has a scalar zero/default attribute (integer, index,
// or float); poison of any other type stays illegal.
Constraint HasDefaultValue(type: Type) [{
  return ::mlir::success(
      static_cast<bool>(::mlir::emitrust::getDefaultValueAttr(type)));
}];

// Returns the zero/default typed attribute of `type`.
Rewrite DefaultValueAttrOf(type: Type) -> Attr [{
  return ::mlir::emitrust::getDefaultValueAttr(type);
}];

//===----------------------------------------------------------------------===//
// Patterns
//===----------------------------------------------------------------------===//

// Replaces `ub.poison` with an `emitrust.constant` holding the zero/default
// value of the result type.
Pattern UBPoisonToEmitRustConstant with benefit(2) {
  let root = op<ub.poison> -> (resultType: Type);
  HasDefaultValue(resultType);
  replace root with
      op<emitrust.constant> {value = DefaultValueAttrOf(resultType)}
      -> (resultType);
}
